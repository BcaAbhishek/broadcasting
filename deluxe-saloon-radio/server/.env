# Copy this file to .env and fill in both values.

# Free YouTube Data API v3 key — see README for how to get one.
YOUTUBE_API_KEY=AIzaSyA2lFGsfg6WYReyoDT5jeCTfyqy_MRN-VE

# The playlist ID from your YouTube playlist URL, e.g. for
# https://www.youtube.com/playlist?list=PLxxxxxxxxxxxxxxxx
# the ID is PLxxxxxxxxxxxxxxxx
# Different playlists at different times of day (24-hour clock, IST)
YOUTUBE_SCHEDULE=6-12:PLQeubVHFkz3U,12-18:PLbGIEvU5HsSw,18-24:PLAouK_1w8KpM

# Fallback for hours not covered by the schedule (midnight–6AM) — using
# the night playlist here since it's still nighttime in that window
YOUTUBE_PLAYLIST_ID=PLbGIEvU5HsSw

# Timezone the schedule times are interpreted in
TIMEZONE=Asia/Kolkata
